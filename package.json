{
  "name": "mellon",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "node --require ./scripts/windows-fs-compat.cjs node_modules/next/dist/bin/next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test:e2e": "npm run build && playwright test",
    "test:cms": "npm run build && playwright test --config playwright.cms.config.ts",
    "validate:model": "node scripts/validate-model.mjs",
    "cms:migrate": "tsx scripts/cms-migrate.ts",
    "cms:admin": "tsx scripts/cms-admin.ts",
    "cms:cleanup": "tsx scripts/cms-cleanup.ts"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/nunito-sans": "^5.3.0",
    "@fontsource/archivo-black": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "better-auth": "^1.7.12",
    "next": "16.4.2",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "three": "^0.186.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "gltf-validator": "^2.0.0-dev.3.10",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
