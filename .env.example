# Neon pooled connection string, including sslmode=require. Keep server-only.
DATABASE_URL=
# Exact origin of this app; change to your HTTPS domain when deploying.
BETTER_AUTH_URL=http://127.0.0.1:3010
# Generate at least 32 random bytes; do not use the sample text as a secret.
BETTER_AUTH_SECRET=
# Comma-separated emails authorized to manage listings.
ADMIN_EMAILS=
# Used only by npm run cms:admin. Clear the password after creating an account.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_NAME=
ADMIN_BOOTSTRAP_PASSWORD=
