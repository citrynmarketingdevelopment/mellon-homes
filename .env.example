# Neon pooled connection string, including sslmode=require. Keep server-only.
DATABASE_URL=
# Home valuation: leave the key blank for personal-review requests only.
RENTCAST_API_KEY=
# Public origin with no trailing slash; set this behind a reverse proxy.
VALUATION_SITE_ORIGIN=
# Hard cap for this application's RentCast calls per UTC calendar month.
VALUATION_MONTHLY_LIMIT=50
# Set only to a header your deployment proxy overwrites with the real client IP.
# Without this setting, the site shares a conservative 10 requests/hour limit.
VALUATION_TRUSTED_IP_HEADER=
# SMTP delivery to the broker; all leads also remain in /admin/leads.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
LEAD_EMAIL_TO=ianmellon@yahoo.com
# Exact origin of this app; change to your HTTPS domain when deploying.
BETTER_AUTH_URL=http://127.0.0.1:3010
# Generate at least 32 random bytes; do not use the sample text as a secret.
BETTER_AUTH_SECRET=
# Comma-separated emails authorized to manage listings.
ADMIN_EMAILS=
# Used only by npm run cms:admin. Clear the password after creating an account.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_NAME=
ADMIN_BOOTSTRAP_PASSWORD=
