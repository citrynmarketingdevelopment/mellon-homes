      "children": [
        {
          "type": "text",
          "id": "bhO8Y",
          "name": "Concept review title",
          "fill": "#40142B",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "MELLON / THREE WAYS FORWARD",
          "lineHeight": 1.1,
          "fontFamily": "Archivo Black",
          "fontSize": 42,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "u0WwN",
          "name": "Shared strategy",
          "fill": "#40142B",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Reframe the mascot-led hero around a clear brokerage promise. Put Mellon's own properties first. Make specialist seller support easy to find. Keep broader market search secondary.",
          "lineHeight": 1.4,
          "fontFamily": "Nunito Sans",
          "fontSize": 22,
          "fontWeight": "normal"
        },
        {
          "type": "frame",
          "id": "gD1p0",
          "name": "Three concept summaries",
          "width": "fill_container",
          "gap": 22,
          "children": [
            {
              "type": "frame",
              "id": "UGVyJ",
              "name": "01 Bright Beginnings summary",
              "width": "fill_container",
              "fill": "#F7DBE7",
              "cornerRadius": 18,
              "layout": "vertical",
              "gap": 16,
              "padding": 26,
              "children": [
                {
                  "type": "text",
                  "id": "n224Oy",
                  "name": "01 Bright Beginnings title",
                  "fill": "#40142B",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "01 Bright Beginnings",
                  "lineHeight": 1.4,
                  "fontFamily": "Nunito Sans",
                  "fontSize": 25,
                  "fontWeight": "900"
                },
                {
                  "type": "text",
                  "id": "Vha9Z",
                  "name": "01 Bright Beginnings idea",
                  "fill": "#40142B",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "The closest continuation of the current mascot hero. Warm, memorable, and equally welcoming to buyers and sellers.",
                  "lineHeight": 1.4,
                  "fontFamily": "Nunito Sans",
                  "fontSize": 17,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "fe69H",
              "name": "02 A Clear Way Forward summary",
              "width": "fill_container",
              "fill": "#F7E9ED",
              "cornerRadius": 18,
              "layout": "vertical",
              "gap": 16,
              "padding": 26,
              "children": [
                {
                  "type": "text",
                  "id": "TlkQZ",
                  "name": "02 A Clear Way Forward title",
                  "fill": "#123F33",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "02 A Clear Way Forward",
                  "lineHeight": 1.4,
                  "fontFamily": "Nunito Sans",
                  "fontSize": 25,
                  "fontWeight": "900"
                },
                {
                  "type": "text",
                  "id": "fGyCs",
                  "name": "02 A Clear Way Forward idea",
                  "fill": "#123F33",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "A calmer advisory direction. Ian's specialist experience leads the message, with a restrained mascot and an editorial listing presentation.",
                  "lineHeight": 1.4,
                  "fontFamily": "Nunito Sans",
                  "fontSize": 17,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "myH86",
              "name": "03 Local Opportunity summary",
              "width": "fill_container",
              "fill": "#FCE0E9",
              "cornerRadius": 18,
              "layout": "vertical",
              "gap": 16,
              "padding": 26,
              "children": [
                {
                  "type": "text",
                  "id": "Peasy",
                  "name": "03 Local Opportunity title",
                  "fill": "#123B2D",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "03 Local Opportunity",
                  "lineHeight": 1.4,
                  "fontFamily": "Nunito Sans",
                  "fontSize": 25,
                  "fontWeight": "900"
                },
                {
                  "type": "text",
                  "id": "q1MG5",
                  "name": "03 Local Opportunity idea",
                  "fill": "#123B2D",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "A property-led brokerage direction. Oversized photography and the development pipeline take priority, while specialist seller support stays easy to find.",
                  "lineHeight": 1.4,
                  "fontFamily": "Nunito Sans",
                  "fontSize": 17,
                  "fontWeight": "normal"
                }
              ]
            }
          ]
        },
        {
          "type": "frame",
          "id": "hojme",
