                  "name": "Content integrity label",
                  "fill": "#40142B",
                  "textGrowth": "fixed-width",
                  "width": 210,
                  "content": "Content integrity",
                  "lineHeight": 1.4,
                  "fontFamily": "Nunito Sans",
                  "fontSize": 15,
                  "fontWeight": "900"
                },
                {
                  "type": "text",
                  "id": "jzr9f",
                  "name": "Content integrity note",
                  "fill": "#40142B",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Property imagery comes from the identical-build flyer and is illustrative. No prices, active listing statuses, customer claims, or testimonials have been invented. Pipeline stages are from the supplied flyer and need confirmation before publication.",
                  "lineHeight": 1.4,
                  "fontFamily": "Nunito Sans",
                  "fontSize": 15,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "FldQU",
              "name": "Listing feed",
              "width": "fill_container",
              "gap": 25,
              "children": [
                {
                  "type": "text",
                  "id": "kAix9",
                  "name": "Listing feed label",
                  "fill": "#40142B",
                  "textGrowth": "fixed-width",
                  "width": 210,
                  "content": "Listing feed",
                  "lineHeight": 1.4,
                  "fontFamily": "Nunito Sans",
                  "fontSize": 15,
                  "fontWeight": "900"
                },
                {
                  "type": "text",
                  "id": "IrxtI",
                  "name": "Listing feed note",
                  "fill": "#40142B",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Use Mellon's own approved inventory in a local CMS first. Broader search is a separate provider slot. Zillow's official Bridge API requires MLS-partner approval; a free Zillow, Realtor.com, or Trulia display feed has not been confirmed. External search links are a practical interim option.",
                  "lineHeight": 1.4,
                  "fontFamily": "Nunito Sans",
                  "fontSize": 15,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "hAAU2",
              "name": "Interaction and mobile",
              "width": "fill_container",
              "gap": 25,
              "children": [
                {
                  "type": "text",
                  "id": "klxjV",
                  "name": "Interaction and mobile label",
                  "fill": "#40142B",
                  "textGrowth": "fixed-width",
                  "width": 210,
                  "content": "Interaction and mobile",
                  "lineHeight": 1.4,
                  "fontFamily": "Nunito Sans",
                  "fontSize": 15,
                  "fontWeight": "900"
                },
                {
                  "type": "text",
                  "id": "lVV15",
                  "name": "Interaction and mobile note",
                  "fill": "#40142B",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Keep the existing exact-logo eye tracking. On mobile: headline, mascot, primary action, then stacked sections. No video background. Respect reduced motion; retain keyboard focus and touch-sized controls.",
                  "lineHeight": 1.4,
                  "fontFamily": "Nunito Sans",
                  "fontSize": 15,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
