                },
                {
                  "type": "text",
                  "id": "lCDVX",
                  "name": "Recommended starting point note",
                  "fill": "#40142B",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Bright Beginnings preserves the current personality. Borrow Clear Way Forward's careful seller language and Local Opportunity's property emphasis.",
                  "lineHeight": 1.4,
                  "fontFamily": "Nunito Sans",
                  "fontSize": 15,
                  "fontWeight": "normal"
                }
